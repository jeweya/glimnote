{
  "name": "glimnote",
  "description": "萤光笔记 Glimnote —— 萤火微光，记录细碎微小的灵感。本地优先的 Markdown 笔记，自动同步到私有 Git 仓库。",
  "private": true,
  "license": "MIT",
  "author": "Glimnote contributors",
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/jewey/glimnote.git"
  },
  "homepage": "https://gitcode.com/jewey/glimnote",
  "bugs": {
    "url": "https://gitcode.com/jewey/glimnote/issues"
  },
  "version": "0.1.24",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "web": "vite build && vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron . --dev\"",
    "electron:start": "vite build && electron .",
    "electron:build": "npm run package:win",
    "package:win": "vite build && electron-builder --win --x64 --dir && node scripts/build-installer.mjs && node scripts/verify-package.mjs",
    "installer": "node scripts/build-installer.mjs",
    "release:win": "npm run package:win && npm run release:manifest && npm run release:verify && npm run release:folder",
    "release:verify": "node scripts/verify-package.mjs",
    "release:manifest": "node scripts/update-manifest.mjs",
    "release:folder": "node scripts/release-folder.mjs",
    "patch:icon": "node scripts/patch-exe-icon.cjs",
    "mcp": "node mcp/server.mjs --stdio",
    "mcp:http": "node mcp/server.mjs --http --port 8765",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:mcp": "node scripts/test-mcp-http.cjs && node scripts/test-mcp-ideas.mjs && node scripts/test-mcp-apps.mjs",
    "test:ui": "npm run build && node scripts/test-mcp-ui.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@isomorphic-git/lightning-fs": "^4.6.0",
    "@lezer/highlight": "^1.2.1",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "buffer": "^6.0.3",
    "dompurify": "^3.1.7",
    "electron-updater": "^6.3.9",
    "isomorphic-git": "^1.27.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.451.0",
    "marked": "^14.1.2",
    "minisearch": "^7.1.0",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.48.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
