# 验证脚本生成的截图（scripts/*.mjs 会按需重新创建）
shots*/

# Python 缓存（docs/tools 下的脚本）
__pycache__/

# 内部开发文档与截图：只保留在本地，不提交（对外只留 README 用图）
/docs/mydoc/

# 本机工具缓存：electron / electron-builder 下载的二进制（约 200MB）
.cache/

# AI 编码工具与工作记录：只在本机使用，不随仓库同步
.claude/
.workbuddy/

# 安卓客户端：在独立仓库里维护，不跟笔记仓库一起提交
android/
ios/

# 临时同步测试文件
__sync_test.txt

# 编辑器 / 本地环境配置
.vscode/
.idea/
.env
.env.*
!.env.example
